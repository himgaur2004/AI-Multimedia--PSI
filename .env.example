# ── Backend Configuration ───────────────────────────────────────────────────
# Copy this file to .env in root or /backend and fill in real values.

# App Identity
PROJECT_NAME="PSI - AI Document & Multimedia Q&A"
VERSION=1.0.0

# Security — CHANGE BEFORE DEPLOYING
SECRET_KEY=replace_me_with_a_random_64_char_string

# LLM Providers (Optional — App functions 100% offline via Inbuilt FAISS RAG)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...

# Database (MongoDB Atlas / Local SQLite)
# For AWS EC2: specify your MongoDB Atlas URI or leave blank for persistent local SQLite
MONGODB_URL=
DATABASE_URL=sqlite:///./psi.db

# Storage
MAX_FILE_SIZE_MB=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS — Allowed frontend domains
CORS_ORIGINS="https://ai-multimedia-psi.vercel.app,http://localhost:5173,http://localhost:3000"

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# VITE_API_URL=https://15.252.181.80.nip.io
