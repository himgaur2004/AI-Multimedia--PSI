# ── Backend (Railway) ─────────────────────────────────────────────────────────
# Copy this file to .env in /backend and fill in real values.

# App Identity
PROJECT_NAME=PSI - AI Document & Multimedia Q&A
VERSION=1.0.0

# Security — CHANGE BEFORE DEPLOYING
SECRET_KEY=replace_me_with_a_random_64_char_string

# OpenAI
OPENAI_API_KEY=sk-...

# Database (MongoDB / Local SQLite)
# On Railway: ${{MongoDB.MONGO_URL}} or MongoDB Atlas URI
MONGODB_URL=mongodb://127.0.0.1:27017/psi_db
DATABASE_URL=sqlite:///./psi.db

# Storage
MAX_FILE_SIZE_MB=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS — add your Vercel frontend URL here
# CORS_ORIGINS=["https://psi.vercel.app","http://localhost:5173"]

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# Set these as Vercel Environment Variables in the dashboard.

# Point to your Railway backend URL
# VITE_API_URL=https://psi-backend.up.railway.app
